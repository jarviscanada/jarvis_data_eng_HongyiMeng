MSA0001  DFHMSD TYPE=&SYSPARM,MODE=INOUT,CTRL=FREEKB,                  X
               LANG=COBOL,TIOAPFX=YES,                                 X
               DSATTS=(COLOR,HILIGHT),                                 X
               MAPATTS=(COLOR,HILIGHT),                                X
               STORAGE=AUTO
***********************************************************************
MPA0001  DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
***********************************************************************
** TRANSACTION
***********************************************************************
         DFHMDF POS=(1,1),LENGTH=5,ATTRB=PROT,                         X
               COLOR=TURQUOISE,INITIAL='TRAN:'
TRANSID  DFHMDF POS=(1,7),LENGTH=4,ATTRB=PROT,                         X
               COLOR=NEUTRAL
***********************************************************************
** PROGRAM
***********************************************************************
         DFHMDF POS=(2,1),LENGTH=5,ATTRB=PROT,                         X
               COLOR=TURQUOISE,INITIAL='PROG:'
PROGNM   DFHMDF POS=(2,7),LENGTH=8,ATTRB=PROT,                         X
               COLOR=NEUTRAL
***********************************************************************
** DATE
***********************************************************************
         DFHMDF POS=(1,63),LENGTH=5,ATTRB=PROT,                        X
               COLOR=TURQUOISE,INITIAL='DATE:'
CURDATE  DFHMDF POS=(1,69),LENGTH=10,ATTRB=PROT,                       X
               COLOR=NEUTRAL
***********************************************************************
** TIME
***********************************************************************
         DFHMDF POS=(2,63),LENGTH=5,ATTRB=PROT,                        X
               COLOR=TURQUOISE,INITIAL='TIME:'
CURTIME  DFHMDF POS=(2,69),LENGTH=8,ATTRB=PROT,                        X
               COLOR=NEUTRAL
