** TITLE
***********************************************************************
         DFHMDF POS=(6,22),LENGTH=39,ATTRB=PROT,                       X
               COLOR=NEUTRAL,                                          X
               INITIAL='+-------------------------------------+'
         DFHMDF POS=(7,22),LENGTH=39,ATTRB=PROT,                       X
               COLOR=NEUTRAL,                                          X
               INITIAL='|    A D D   N E W   S T U D E N T    |'
         DFHMDF POS=(8,22),LENGTH=39,ATTRB=PROT,                       X
               COLOR=NEUTRAL,                                          X
               INITIAL='+-------------------------------------+'
***********************************************************************
** LAST NAME
***********************************************************************
         DFHMDF POS=(13,25),LENGTH=10,ATTRB=PROT,                      X
               COLOR=YELLOW,                                           X
               INITIAL='Last Name:'
LNAME    DFHMDF POS=(13,36),LENGTH=12,ATTRB=(UNPROT,IC),               X
               COLOR=NEUTRAL,HILIGHT=UNDERLINE
         DFHMDF POS=(13,49),LENGTH=1,ATTRB=ASKIP                      
***********************************************************************
** FIRST NAME
***********************************************************************
         DFHMDF POS=(14,24),LENGTH=11,ATTRB=PROT,                      X
               COLOR=YELLOW,                                           X
               INITIAL='First Name:'
FNAME    DFHMDF POS=(14,36),LENGTH=12,ATTRB=UNPROT,                    X
               COLOR=NEUTRAL,HILIGHT=UNDERLINE
         DFHMDF POS=(14,49),LENGTH=1,ATTRB=ASKIP                      
***********************************************************************
** BIRTHDAY
***********************************************************************
         DFHMDF POS=(15,26),LENGTH=9,ATTRB=PROT,                       X
               COLOR=YELLOW,                                           X
               INITIAL='Birthday:'
BDAY     DFHMDF POS=(15,36),LENGTH=10,ATTRB=UNPROT,                    X
               COLOR=NEUTRAL,HILIGHT=UNDERLINE
         DFHMDF POS=(15,47),LENGTH=13,ATTRB=ASKIP,                     X
               COLOR=YELLOW,                                           X
               INITIAL=' (mm/dd/yyyy)'
***********************************************************************
** COURSE
***********************************************************************
         DFHMDF POS=(16,28),LENGTH=7,ATTRB=PROT,                       X
               COLOR=YELLOW,                                           X
               INITIAL='Course:'
COURSE   DFHMDF POS=(16,36),LENGTH=12,ATTRB=UNPROT,                    X
               COLOR=NEUTRAL,HILIGHT=UNDERLINE
         DFHMDF POS=(16,49),LENGTH=1,ATTRB=ASKIP    
