               COLOR=BLUE,                                             X
               INITIAL='F1=Help'
         DFHMDF POS=(24,32),LENGTH=7,ATTRB=PROT,                       X
               COLOR=BLUE,                                             X
               INITIAL='F3=Back'
***********************************************************************
         DFHMSD TYPE=FINAL
         END
